table 'Reseller Sales'

	measure 'Order Qty' = sum('Reseller Sales'[OrderQuantity])
		formatString: #,0

		annotation Format = <Format Format="NumberWhole" Accuracy="0" ThousandSeparator="True" />

	measure 'Total Cost' = sum('Reseller Sales'[TotalProductCost])
		formatString: "€"#,0.00;-"€"#,0.00;"€"#,0.00

		annotation Format = <Format Format="CurrencyCustom" Accuracy="2" ThousandSeparator="True"><Currency LCID="6153" DisplayName="€ English (Ireland)" Symbol="€" PositivePattern="0" NegativePattern="1" /></Format>

	measure 'Freight Amount' = sum('Reseller Sales'[Freight])
		formatString: "€"#,0.00;-"€"#,0.00;"€"#,0.00

		annotation Format = <Format Format="CurrencyCustom" Accuracy="2" ThousandSeparator="True"><Currency LCID="6153" DisplayName="€ English (Ireland)" Symbol="€" PositivePattern="0" NegativePattern="1" /></Format>

	measure 'Sales Amount' = sum('Reseller Sales'[SalesAmount])
		formatString: #,0.00

		annotation Format = <Format Format="NumberDecimal" Accuracy="2" ThousandSeparator="True" />

	measure Margin = [Sales Amount] - [Total Cost]
		formatString: "€"#,0.0;-"€"#,0.0;"€"#,0.0

		annotation Format = <Format Format="CurrencyCustom" Accuracy="1" ThousandSeparator="True"><Currency LCID="6153" DisplayName="€ English (Ireland)" Symbol="€" PositivePattern="0" NegativePattern="1" /></Format>

	measure 'Sales Amount EUR' =
			SUMX ( 'Reseller Sales',
			        'Reseller Sales'[SalesAmount] * 'Reseller Sales'[EuroER])
		formatString: #,0.00

		annotation Format = <Format Format="NumberDecimal" Accuracy="2" ThousandSeparator="True" />

	measure 'Row Count' = COUNTROWS('Reseller Sales')
		formatString: #,0

		annotation Format = <Format Format="NumberWhole" Accuracy="0" ThousandSeparator="True" />

	measure 'Open Orders' = DISTINCTCOUNT(OpenOrders[SalesOrderNumber])
		formatString: #,0

		annotation Format = <Format Format="NumberDecimal" Accuracy="0" ThousandSeparator="True" />

	measure 'Sales Amount USD' =
			SUMX ( 'Reseller Sales',
			        'Reseller Sales'[SalesAmount] * 'Reseller Sales'[DollarER])
		formatString: #,0.00

		annotation Format = <Format Format="NumberDecimal" Accuracy="2" ThousandSeparator="True" />

	measure Orders = DISTINCTCOUNT('Reseller Sales'[SalesOrderNumber])
		formatString: #,0

		annotation Format = <Format Format="NumberWhole" Accuracy="0" ThousandSeparator="True" />

