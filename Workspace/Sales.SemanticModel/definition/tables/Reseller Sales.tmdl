	column EuroER =
			IF (
			                    ISBLANK (
			                        LOOKUPVALUE (
			                            ExchangeRates[AverageRate],
			                            ExchangeRates[Date], DATE ( YEAR ( 'Reseller Sales'[OrderDate] ), MONTH ( 'Reseller Sales'[OrderDate] ), 1 ),
			                            ExchangeRates[CurrencyKey], LOOKUPVALUE ( 'Currency'[CurrencyKey], 'Currency'[Currency Code], "EUR" )
			                        )
			                    ),
			                    CALCULATE (
			                        AVERAGE ( ExchangeRates[AverageRate] ),
			                        'Currency'[Currency Code] = "EUR",
			                        ALL ( 'Date' )
			                    ),
			                    LOOKUPVALUE (
			                        ExchangeRates[AverageRate],
			                        ExchangeRates[Date], DATE ( YEAR ( 'Reseller Sales'[OrderDate] ), MONTH ( 'Reseller Sales'[OrderDate] ), 1 ),
			                        ExchangeRates[CurrencyKey], LOOKUPVALUE ( 'Currency'[CurrencyKey], 'Currency'[Currency Code], "EUR" )
			                    )
			                )
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation Format = <Format Format="General" />

		annotation DataTypeAtRefresh = Double#####not a type

	column DollarER =
			IF (
			                    ISBLANK (
			                        LOOKUPVALUE (
			                            ExchangeRates[AverageRate],
			                            ExchangeRates[Date], DATE ( YEAR ( 'Reseller Sales'[OrderDate] ), MONTH ( 'Reseller Sales'[OrderDate] ), 1 ),
			                            ExchangeRates[CurrencyKey], LOOKUPVALUE ( 'Currency'[CurrencyKey], 'Currency'[Currency Code], "USD" )
			                        )
			                    ),
			                    CALCULATE (
			                        AVERAGE ( ExchangeRates[AverageRate] ),
			                        'Currency'[Currency Code] = "EUR",
			                        ALL ( 'Date' )
			                    ),
			                    LOOKUPVALUE (
			                        ExchangeRates[AverageRate],
			                        ExchangeRates[Date], DATE ( YEAR ( 'Reseller Sales'[OrderDate] ), MONTH ( 'Reseller Sales'[OrderDate] ), 1 ),
			                        ExchangeRates[CurrencyKey], LOOKUPVALUE ( 'Currency'[CurrencyKey], 'Currency'[Currency Code], "USD" )
			                    )
			                )
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation Format = <Format Format="General" />

		annotation DataTypeAtRefresh = Double#####not a type

